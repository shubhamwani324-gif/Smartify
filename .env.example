# SMARTIFY - Environment Variables Example
# Copy this file to .env for local development or configure in Render Dashboard -> Environment

# Server Configuration
PORT=5000
NODE_ENV=production
FLASK_ENV=production
PYTHON_VERSION=3.11.9

# Application Secret Key (Used for JWT sessions and cryptographic token signatures)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars-minimum

# Razorpay Payment Gateway (Test Mode for development & evaluation)
# Keep in Test Mode (rzp_test_...) - Do NOT commit Live Mode keys to GitHub
RAZORPAY_KEY_ID=rzp_test_TloKHUV0Il3Vuz
RAZORPAY_KEY_SECRET=9O51MziAzM0PmXGjXkhRcg5m
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_smartify_2026

# Google OAuth 2.0 Credentials (Phase 3: Genuine Google Sign-In)
# Obtain from https://console.cloud.google.com/apis/credentials
# Authorized Javascript origins: http://localhost:5000 and your Render domain
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000

# Indian Mobile SMS & OTP Provider (Phase 4: Phone Authentication)
# Supported options: dev | fast2sms | twilio
# In local dev / demo mode, defaults to 'dev' (returns OTP in test response without charging money)
SMS_PROVIDER=dev
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Persistent Storage & Database
# By default, SMARTIFY reads/writes to server/data/gharva.json with automatic seed fallback.
# For Render persistent disks, set DATA_DIR to your mount path (e.g. /var/data):
# DATA_DIR=/var/data
# DATA_FILE=/var/data/gharva.json
