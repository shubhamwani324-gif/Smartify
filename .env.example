# SMARTIFY Environment Variables Example
# Copy this to .env or configure in Render Dashboard -> Environment

# Server Configuration
PORT=5000
NODE_ENV=production
FLASK_ENV=production
PYTHON_VERSION=3.11.9

# Application Secret Key (Used for JWT authentication and session security)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars-minimum

# Razorpay Test Mode Configuration (Do NOT change to live keys during testing)
RAZORPAY_KEY_ID=rzp_test_TloKHUV0Il3Vuz
RAZORPAY_KEY_SECRET=9O51MziAzM0PmXGjXkhRcg5m
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_smartify_2026

